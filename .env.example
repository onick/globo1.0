# Ports match docker-compose.yml (db 5434, redis 6380, traccar 8083)

# Database - Globo
DATABASE_URL=postgresql://globo:YOUR_PASSWORD@localhost:5434/globo
DB_PASSWORD=YOUR_PASSWORD
# Empty database Prisma uses to check migrations against the schema (npm run db:check)
SHADOW_DATABASE_URL=postgresql://globo:YOUR_PASSWORD@localhost:5434/globo_shadow

# Database - Traccar
TRACCAR_DB_PASSWORD=YOUR_PASSWORD

# Redis
REDIS_URL=redis://localhost:6380

# Traccar
TRACCAR_API_URL=http://localhost:8083/api
TRACCAR_WS_URL=ws://localhost:8083/api/socket
# OsmAnd port, used by scripts/simulate-devices.ts
TRACCAR_OSMAND_URL=http://localhost:5055
TRACCAR_ADMIN_EMAIL=admin@globo.local
TRACCAR_ADMIN_PASSWORD=YOUR_PASSWORD

# Auth
NEXTAUTH_SECRET=YOUR_RANDOM_SECRET
NEXTAUTH_URL=http://localhost:3000


# Map matching (optional): snaps routes to the roads. Uses the osrm service in
# docker-compose (prepare the map first: scripts/osrm-prepare.sh, see docs/osrm.md).
# Leave empty to show straight lines between GPS fixes.
OSRM_URL=http://localhost:5100

# Public domain trackers send their positions to (shown with the SMS setup commands on each
# device page; each tracker model adds its own Traccar port). Use a domain, e.g.
# trackers.yourcompany.com, not an IP: moving the server then only changes the DNS record.
# See docs/rastreadores.md.
TRACKER_SERVER_HOST=
# Max coordinates per match request (osrm-routed default: 100)
OSRM_MATCH_MAX_POINTS=100

# Traccar bridge (live positions + alert engine) starts with the server; "off" disables it.
# See docs/alertas.md
TRACCAR_BRIDGE=on

# Alert notifications (see docs/alertas.md). Links in messages point to APP_URL.
APP_URL=http://localhost:3000
ALERT_TIMEZONE=America/Santo_Domingo
# Email
SMTP_URL=
MAIL_FROM=
# WhatsApp Cloud API: needs an approved template with 4 body parameters
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v23.0
